{
  // IMPORTANT: If you had "extends": "./tsconfig.json" here, remove it.
  // The root tsconfig.json no longer defines base compilerOptions.
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,

    // --- CRITICAL FOR PROJECT REFERENCES ---
    "composite": true,        // <--- This MUST be true
    "declaration": true,      // <--- Essential for composite projects (emits .d.ts files)
    "outDir": "./dist/app",   // <--- Specify an output directory
    // "noEmit": true,         // <--- This MUST be REMOVED (or set to false if your TS version allows)
    // ---------------------------------------

    "jsx": "react-jsx",
    "baseUrl": "."
  },
  "include": ["src"],
  "exclude": ["node_modules", "build", "dist"] // Exclude the new output directory
}
